# Build directories and CMake artifacts
build/
cmake-build-*/
*.tmp

# LLVM and C/C++ compiled objects and libraries
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.out
*.exe

# Temporary LLVM bitcode files (preserve tracked test inputs in examples/)
*.bc
*.tmp.ll
!examples/*.ll

# Executables and temporary test binaries
allocation_test

# Node dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Frontend build outputs
dist/
frontend/dist/

# Backend workspaces, uploads, and runtime directories
backend/.workspaces/
.workspaces/
backend/uploads/
uploads/
backend/logs/

# Environment files and secrets
.env
.env.local
.env.*.local
backend/.env
backend/.env.local
backend/.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Allow example environment files
!.env.example
!backend/.env.example
!frontend/.env.example

# Logs and runtime traces
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Test coverage
coverage/

# OS and Editor metadata
.DS_Store
Thumbs.db
.vscode/
.idea/

# Internal roadmaps and drafts
memoryguard_roadmap.md
