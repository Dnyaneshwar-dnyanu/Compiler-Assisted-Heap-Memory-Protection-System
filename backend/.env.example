# MemoryGuard Backend Environment Variables
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*
MAX_REQUEST_SIZE=1mb

# MemoryGuard LLVM Toolchain Configuration
# Compiler tool executables (default: clang-18, clang++-18, opt-18)
MG_CLANG=clang-18
MG_CLANGXX=clang++-18
MG_OPT=opt-18

# Paths to built MemoryGuard compiler pass plugin and runtime library
MG_PASS_PLUGIN=../build/compiler/MemoryGuardPass.so
MG_RUNTIME_LIBRARY=../build/libmemoryguard.a
MG_RUNTIME_INCLUDE=../runtime/include

# Compilation workspace and resource limits
MG_WORKSPACE_ROOT=.workspaces
MG_COMPILER_TIMEOUT_MS=15000
MG_MAX_SOURCE_BYTES=524288
MG_MAX_OUTPUT_BYTES=262144

# Platform execution mode: auto-detects WSL on Windows if set to true or omitted
# MG_USE_WSL=true
